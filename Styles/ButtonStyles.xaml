    <!-- CheckBox Styles-->
    <Style x:Key="EmployeeCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- The box -->
                        <Border x:Name="Box"
                            Width="20" Height="20"
                            CornerRadius="4"
                            BorderThickness="1.5"
                            BorderBrush="#E0E0E0"
                            Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4"
                                              ShadowDepth="1"
                                              Color="#171A1C"
                                              Opacity="0.08"/>
                            </Border.Effect>

                            <!-- Checkmark -->
                            <Viewbox x:Name="Check"
                                 Width="12" Height="12"
                                 Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5,12 L10,17 L19,7"
                                      Stroke="White"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Label -->
                        <ContentPresenter Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"   Property="Background"   Value="#5681BD"/>
                            <Setter TargetName="Box"   Property="BorderBrush"  Value="#5681BD"/>
                            <Setter TargetName="Check" Property="Visibility"   Value="Visible"/>
                        </Trigger>

                        <!-- Hover (unchecked) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#378ADD"/>
                            <Setter TargetName="Box" Property="Background"  Value="#F0F7FF"/>
                        </MultiTrigger>

                        <!-- Hover (checked) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="#6B91C7"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#6B91C7"/>
                        </MultiTrigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

