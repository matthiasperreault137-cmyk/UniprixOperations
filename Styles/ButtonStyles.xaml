    <Style x:Key="ClearAll" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="#E53E3E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                            <!-- Trash icon -->
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <!-- Lid -->
                                    <Path Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M3,6 H21"/>
                                    <!-- Lid handle -->
                                    <Path Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M9,6 V4 H15 V6"/>
                                    <!-- Bin body -->
                                    <Path Stroke="White" StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M5,6 L6,20 H18 L19,6"/>
                                    <!-- Bin lines -->
                                    <Line X1="10" Y1="10" X2="10" Y2="17" Stroke="White" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="14" Y1="10" X2="14" Y2="17" Stroke="White" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#C53030"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#9B2C2C"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="#A0AEC0"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Completion Buttons-->

    <Style x:Key="EmployeeCompleteButton" TargetType="Button">
        <!-- Layout -->
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin"   Value="5"/>

        <!-- Typography -->
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>

        <!-- Shape & Color -->
        <Setter Property="Background" Value="#5681BD"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#171A1C"
                                          Opacity="0.09"
                                          BlurRadius="8"
                                          ShadowDepth="4"
                                          Direction="270"/>
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Viewbox Width="28" Height="28">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Width="22" Height="22"
                                         Canvas.Left="1" Canvas.Top="1"
                                         Stroke="White" StrokeThickness="1.5"
                                         Fill="Transparent"/>
                                    <Path Data="M7,12 L10.5,15.5 L17,9"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="Marquer Tout Comme Fait"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#6B91C7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#4A71AD"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

