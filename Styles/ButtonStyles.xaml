        <Setter Property="Background" Value="#2B6CB0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="10"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Printer Icon -->
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <!-- Paper feed (top) -->
                                    <Path Fill="White" Data="M8,3 H16 V9 H8 Z"/>
                                    <!-- Printer body -->
                                    <Path Fill="White" Data="M4,9 H20 C20.55,9 21,9.45 21,10 V16 H3 V10 C3,9.45 3.45,9 4,9 Z"/>
                                    <!-- Output tray -->
                                    <Path Fill="White" Data="M6,16 H18 V21 H6 Z"/>
                                    <!-- Paper lines -->
                                    <Line X1="9" Y1="17.8" X2="15" Y2="17.8" Stroke="#A0AEC0" StrokeThickness="1.2"/>
                                    <Line X1="9" Y1="19.5" X2="13" Y2="19.5" Stroke="#A0AEC0" StrokeThickness="1.2"/>
                                    <!-- Ink dot -->
                                    <Ellipse Canvas.Left="15.5" Canvas.Top="11.5" Width="2.5" Height="2.5" Fill="#63B3ED"/>
                                </Canvas>
                            </Viewbox>

                            <!-- Label -->
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2C5282"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1A365D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="#A0AEC0"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Expired Product-->
    <Style x:Key="ExpiredProductButton" TargetType="Button">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="#F7F8F9"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Height="{TemplateBinding Height}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4"
                                          ShadowDepth="2"
                                          Color="#171A1C"
                                          Opacity="0.08"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="0.3*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Product name -->
                            <ContentPresenter Grid.Column="0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0"/>

                            <!-- Expiry date -->
                            <TextBlock x:Name="ExpiryDate"
                                   Grid.Column="1"
                                   Text="{TemplateBinding Tag}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Foreground="#888888"
                                   FontSize="13"/>

                            <!-- Arrow -->
                            <Path x:Name="arrow"
                              Grid.Column="1"
                              Data="M0,0 L6,7 L0,14"
                              Stroke="#BBBBBB"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"
                              Width="6"
                              Height="14"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="arrow" Property="Stroke" Value="#DD7237"/>
                            <Setter TargetName="ExpiryDate" Property="Foreground" Value="#DD7237"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#DD7237"/>
                <Setter Property="Background" Value="#F0F7FF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E6F1FB"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- MainWindow Stuff -->
    <Style x:Key="LogoutButton" TargetType="Button">

        <!-- Layout -->
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <!-- Font -->
        <Setter Property="Foreground" Value="#E83030"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>

        <!-- Background & Border -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>

        <!-- Control Template -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border"
                            Background="Transparent"
                            CornerRadius="8"/>

                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="12,0">

                            <!-- Logout Icon -->
                            <Path x:Name="icon"
                              Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"
                              Stroke="#E83030"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="20"
                              Height="20"
                              Stretch="Uniform"/>

                            <!-- Label -->
                            <TextBlock Text="Déconnexion"
                                   Foreground="#E83030"
                                   FontFamily="Open Sans"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1AE83030"/>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#33E83030"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>