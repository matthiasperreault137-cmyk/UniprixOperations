<Page x:Class="UniprixOperations.ManagerPages.UserDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserDetails">

    <Grid Grid.Column="1">
        <Border Grid.Row="1" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelMedium}">Nom de l'employé</TextBlock>
                            <TextBox x:Name="UDName" Grid.Row="1" IsReadOnly="True" Style="{StaticResource InputField}"/>
                        </Grid>
                        <!-- Niveau d'assignation -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelMedium}">Rôle</TextBlock>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="UDEmployeeCheck" Grid.Column="0" Content="Employé" Checked="UDEmployeeCheck_Checked" Style="{StaticResource ManagerCheckBox}" IsEnabled="False"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="75" VerticalAlignment="Bottom">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="UDSupervisorCheck" Grid.Row="0" Content="Responsable" Checked="UDSupervisorCheck_Checked" Style="{StaticResource ManagerCheckBox}" IsEnabled="False"/>
                                        <CheckBox x:Name="UDManagerCheck" Grid.Row="1" Content="Gérant" Checked="UDManagerCheck_Checked" Style="{StaticResource ManagerCheckBox}" IsEnabled="False"/>


                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelSmall}">Mot De Passe</TextBlock>
                                        <TextBox Grid.Row="1" x:Name="UDPassword" IsReadOnly="True" Style="{StaticResource InputField}"></TextBox>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2" Margin="10,10,10,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="UDModify" Grid.Column="0" Content="Modifier" Style="{StaticResource ModifyButton}" Click="ModifyUser"/>
                            <Button x:Name="UDDDelete" Grid.Column="1" Content="Supprimer" Style="{StaticResource DeleteButton}" Click="DeleteUser" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
