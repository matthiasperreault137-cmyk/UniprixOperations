<Page x:Class="UniprixOperations.ManagerPages.ManagerExpireMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerExpireMenu">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource ManagerUnselectedTab}"  Click="OpenTasks">Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource ManagerSelectedTab}"  Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Style="{StaticResource ManagerUnselectedTab}"  Click="OpenTaskHistory">Historique</Button>
                </Grid>
                <Grid Grid.Row="4">
                    <Button Style="{StaticResource ManagerUnselectedTab}"  Click="OpenUserMenu">Utilisateurs</Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Style="{StaticResource PageTitle}" > Menu Expirés</TextBlock>
            </Grid>
            <Border Grid.Row="1" Padding="50,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: 2 items centered -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1: Sections -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="0.7*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Image Source="pack://application:,,,/Images/Sections.png" Height="70"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock Style="{StaticResource Subtitle1}">Sections</TextBlock>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Button Style="{StaticResource ManagerContinueButton}" Height="70" Click="OpenSectionList">Continuer →</Button>
                            </Grid>
                        </Grid>

                        <!-- 2: Ajouter une section -->
                        <Grid Grid.Column="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="0.7*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Image Source="pack://application:,,,/Images/AddSection.png" Height="70"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock Style="{StaticResource Subtitle2}">Ajouter une section</TextBlock>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Button Style="{StaticResource ManagerContinueButton}" Height="70" Click="OpenAddSection">Continuer →</Button>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Bottom Row: 3 items -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- 3: Produits Par Section -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="0.7*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Image Source="pack://application:,,,/Images/ProductSections.png" Height="70"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock Style="{StaticResource Subtitle2}" LineHeight="1">Produits Par Section</TextBlock>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Button Style="{StaticResource ManagerContinueButton}" Height="70" Click="OpenSections">Continuer →</Button>
                            </Grid>
                        </Grid>

                        <!-- 4: Ajouter un Produit Expiré -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="0.7*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Image Source="pack://application:,,,/Images/AddProduct2.png" Height="70"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock Style="{StaticResource Subtitle2}" LineHeight="1">Ajouter un Produit Expiré</TextBlock>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Button Style="{StaticResource ManagerContinueButton}" Height="70" Click="OpenAddExpiredProduct">Continuer →</Button>
                            </Grid>
                        </Grid>

                        <!-- 5: Tous les produits -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="0.7*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Image Source="pack://application:,,,/Images/AllProducts.png" Height="70"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock Style="{StaticResource Subtitle2}" LineHeight="1">Tous les produits</TextBlock>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Button Style="{StaticResource ManagerContinueButton}" Height="70" Click="OpenAllProducts">Continuer →</Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
