<Page x:Class="UniprixOperations.ManagerPages.SectionDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SectionDetails">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Nom" Style="{StaticResource FieldLabelLarge}"></TextBlock>
            <TextBox x:Name="SDName" Grid.Row="1" IsReadOnly="True" Style="{StaticResource InputField}"></TextBox>
        </Grid>
        <Grid  Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Description" Style="{StaticResource FieldLabelLarge}"></TextBlock>
            <TextBox x:Name="SDDescription" Grid.Row="1" IsReadOnly="True" Style="{StaticResource InputFieldMultiline}" Height="100"></TextBox>
        </Grid>
        <Grid Grid.Row="2" Margin="10,10,10,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SDModify" Grid.Column="0" Content="Modifier" Style="{StaticResource ModifyButton}" Click="ModifySection"/>
            <Button x:Name="SDDDelete" Grid.Column="1" Content="Supprimer" Style="{StaticResource DeleteButton}" Click="DeleteSection" />
        </Grid>

    </Grid>
</Page>
