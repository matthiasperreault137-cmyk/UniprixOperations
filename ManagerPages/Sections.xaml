<Page x:Class="UniprixOperations.ManagerPages.Sections"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Sections">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTasks">Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource ManagerSelectedTab}" Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTaskHistory">Historique</Button>
                </Grid>
                <Grid Grid.Row="4">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenUserMenu">Utilisateurs</Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!-- Main content -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource PageTitle}">Produits Par Section</TextBlock>

                <Button Grid.Column="3"
                        
                        Style="{StaticResource PrintButton}"
                        Click="PrintProducts">Imprimer la liste</Button>
                <Button Grid.Column="4"
                        
                        Style="{StaticResource ClearAll}"
                        Click="DeleteProducts">Supprimer tout</Button>
            </Grid>
            <Border Grid.Row="1" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="2.5*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Subtitle2}" LineHeight="1"> Sélectionner la rangée</TextBlock>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource ManagerScrollViewer}">
                            <StackPanel x:Name="SSectionList">
                               
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.7*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="SSectionDisplay" Style="{StaticResource FieldLabelLarge}">Rangée 1</TextBlock>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="SSearchBox" Grid.Column="0" Style="{StaticResource InputField}" TextChanged="SearchTextChanged"/>
                                <Grid x:Name="SDatePickerPanel" HorizontalAlignment="Stretch" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" x:Name="SStartDate" SelectedDateChanged="DateChange"
                                    Style="{StaticResource ManagerDatePicker}" Margin="0,0,10,0"/>
                                    <DatePicker Grid.Column="1" x:Name="SEndDate" SelectedDateChanged="DateChange"
                                    Style="{StaticResource ManagerDatePicker}" Margin="0,0,10,0"/>
                                </Grid>
                            </Grid>
                            <ComboBox x:Name="SFiltersComboBox"  Grid.Column="1" Style="{StaticResource ManagerComboBox}" Height="50" SelectedIndex="0" SelectionChanged="SearchFilterChanged">
                                <ComboBoxItem>Nom</ComboBoxItem>
                                <ComboBoxItem>Date D'expiration(plus lointaine)</ComboBoxItem>
                                <ComboBoxItem>Quantité</ComboBoxItem>
                                <ComboBoxItem>Code Upc</ComboBoxItem>
                                <ComboBoxItem>Date</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Row="2" Margin="10,10,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" Style="{StaticResource ManagerScrollViewer}">
                                <StackPanel x:Name="SExpiredProductList">
                                </StackPanel>
                            </ScrollViewer>
                            <Frame Grid.Column="2" x:Name="SProductDetailsFrame">
                                
                            </Frame>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
