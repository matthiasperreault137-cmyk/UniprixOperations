<Page x:Class="UniprixOperations.ManagerPages.CompletedTaskDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CompletedTaskDetails">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- TOP SECTION -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>

                <!-- Nom de la tâche -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Nom de la tâche" Style="{StaticResource FieldLabelMedium}"/>
                        <TextBox x:Name="CTDName" Grid.Row="1" Style="{StaticResource InputField}"/>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Personne ayant complété la tâche" TextWrapping="Wrap" Style="{StaticResource FieldLabelSmall}" LineHeight="1"/>
                        <TextBox x:Name="CTDUser" Grid.Row="1" Style="{StaticResource InputField}"/>
                    </Grid>
                </Grid>

                <!-- Date, Heure, Description -->
                <Grid Grid.Row="1" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column: Date + Heure -->
                    <Grid Grid.Column="0">
                        <Grid x:Name="CTDDisDate">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Date" Style="{StaticResource FieldLabelMedium}"/>
                                <TextBox x:Name="CTDDate" Grid.Row="1" Style="{StaticResource InputField}" Height="30"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Heure" Style="{StaticResource FieldLabelMedium}"/>
                                <TextBox x:Name="CTDHour" Grid.Row="1" Style="{StaticResource InputField}" Height="30"/>
                            </Grid>
                        </Grid>
                        <Grid x:Name="CTDModDate" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.4*"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelMedium}"> Date</TextBlock>
                            <DatePicker x:Name="CTDDatePicker"  Grid.Row="1" Style="{StaticResource ManagerDatePicker}"></DatePicker>
                        </Grid>

                    </Grid>

                    <!-- Right column: Description -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabelMedium}"/>
                        <TextBox x:Name="CTDDescription" Grid.Row="1" Style="{StaticResource InputFieldMultiline}" Height="60"/>
                    </Grid>
                </Grid>
            </Grid>
            <!-- MODIFY + DELETE -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CTDModify"
                    Grid.Column="0"
                    Style="{StaticResource ModifyButton}"
                    Click="ModifyTask">
                    Modifier
                </Button>
                <Button x:Name="CTDDelete"
                    Grid.Column="1"
                    Style="{StaticResource DeleteButton}"
                    Click="DeleteTask">
                    Supprimer
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
