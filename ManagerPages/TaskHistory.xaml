<Page x:Class="UniprixOperations.ManagerPages.TaskHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TaskHistory">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTasks">Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Style="{StaticResource ManagerSelectedTab}" Click="OpenTaskHistory">Historique</Button>
                </Grid>
                <Grid Grid.Row="4">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenUserMenu">Utilisateurs</Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="0.2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SSectionDisplay"
               Grid.Column="2"
               Style="{StaticResource PageTitle}">Historique de Tâches</TextBlock>

                <Button Grid.Column="3"
                        Content="Imprimer"
                        Click="PrintTasks"
                        Margin="0,0,10,0"
                        Style="{StaticResource PrintButton}"/>
                <Button Grid.Column="4"
                        Content="Effacer tout"
                        Click="ClearAllTasks"
                        Margin="0,0,10,0"
                        Style="{StaticResource ClearAll}"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <!-- Search Box -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Recherchez ici" Style="{StaticResource Subtitle1}"></TextBlock>
                    <Grid Grid.Row="1" x:Name="THSearchBox">
                        <TextBox Grid.Row="1" x:Name="THSearchText" Grid.Column="0" TextChanged="SearchTextChanged" Style="{StaticResource InputField}"/>
                        <Grid x:Name="THDatePickerPanel" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" x:Name="THStartDate" SelectedDateChanged="DateChange"
                                    Style="{StaticResource ManagerDatePicker}" Margin="0,0,10,0"/>
                            <DatePicker Grid.Column="1" x:Name="THEndDate" SelectedDateChanged="DateChange"
                                    Style="{StaticResource ManagerDatePicker}" Margin="0,0,10,0"/>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- Search Filters -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Subtitle1}" Text="Filtre de Recherche"></TextBlock>
                    <ComboBox x:Name="THFilters"  Grid.Row="1" Style="{StaticResource ManagerComboBox}" SelectedIndex="0" SelectionChanged="SearchFilterChanged">
                        <ComboBoxItem>Nom de tâche</ComboBoxItem>
                        <ComboBoxItem>Date de complétion(plus lointaine)</ComboBoxItem>
                        <ComboBoxItem>Nom d'utilisateur</ComboBoxItem>
                        <ComboBoxItem>Date</ComboBoxItem>
                    </ComboBox>

                </Grid>
            </Grid>
            
            <Grid Grid.Row="2" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!-- Task list-->
                <ScrollViewer Grid.Column="0" Style="{StaticResource ManagerScrollViewer}">
                    <StackPanel x:Name="THTasks">
                    </StackPanel>
                </ScrollViewer>
                <!-- Task details -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Détails" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                    <Frame Grid.Row="1" x:Name="THTaskDetails">

                    </Frame>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Page>
