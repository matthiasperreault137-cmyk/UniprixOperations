<Page x:Class="UniprixOperations.ManagerPages.ExpiredProductDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExpiredProductDetails">

    <Grid Grid.Column="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Nom -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Nom" Style="{StaticResource FieldLabelMedium}"/>
                <TextBox x:Name="EPDName" Grid.Row="1" Style="{StaticResource InputField}" IsReadOnly="True"
                         />
            </Grid>

            <!-- Code UPC -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Code UPC" Style="{StaticResource FieldLabelMedium}"/>
                <TextBox x:Name="EPDCodeUpc" Grid.Row="1" Style="{StaticResource InputField}" IsReadOnly="True"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Date D'expiration -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Date D'expiration" Style="{StaticResource FieldLabelSmall}"/>
                <TextBox x:Name="EPDExpiryDate" Grid.Row="1" Style="{StaticResource InputField}"
                 IsReadOnly="True"/>
            </Grid>

            <!-- Quantité -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Quantité" Style="{StaticResource FieldLabelSmall}"/>
                <TextBox x:Name="EPDQuantity" Grid.Row="1"
                 Style="{StaticResource InputField}" IsReadOnly="True"/>
            </Grid>

            <!-- En tablettes? — TextBox + CheckBox side by side, shared label above -->
            <Grid Grid.Column="2" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- Shared label spanning both columns -->
                <TextBlock Grid.Row="0" Text="En tablette?" Style="{StaticResource FieldLabelSmall}"/>

                <!-- Inner grid for side-by-side TextBox + CheckBox -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CheckStatus" Grid.Column="0"
                     Style="{StaticResource InputField}"
                     IsReadOnly="True"/>

                    <CheckBox x:Name="EPDShelfStatus" Grid.Column="1"
                      Style="{StaticResource ManagerCheckBox}"
                      Checked="CheckEvent" Unchecked="UncheckEvent" IsEnabled="False" />
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="10,10,10,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="EPDModify" Grid.Column="0" Content="Modifier" Style="{StaticResource ModifyButton}" Click="ModifyProduct"/>
            <Button x:Name="EPDDelete" Grid.Column="1" Content="Supprimer" Style="{StaticResource DeleteButton}" Click="DeleteProduct" />
        </Grid>
    </Grid>
</Page>
