<Page x:Class="UniprixOperations.ManagerPages.ManagerDailyTaskDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerDailyTaskDetails">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="0.8*"/>
                <RowDefinition Height="0.8*"/>
            </Grid.RowDefinitions>

            <!-- TOP SECTION -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- Nom de la tâche -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource FieldLabelLarge}" >Nom de la tâche</TextBlock>
                    <TextBox x:Name="MDTDName" Grid.Row="1" Margin="5" Style="{StaticResource InputField}"/>
                </Grid>

                <!-- Date, Heure, Description -->
                <Grid Grid.Row="1" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column: Date + Heure -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="1.6*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Date" Style="{StaticResource FieldLabelMedium}"/>
                            <TextBox x:Name="MDTDDate" Grid.Row="1" Margin="5" Style="{StaticResource InputField}" Height="40"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="1.4*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Heure" Style="{StaticResource FieldLabelMedium}"/>
                            <TextBox x:Name="MDTDHour" Grid.Row="1" Margin="5" Style="{StaticResource InputField}" Height="40"/>
                        </Grid>
                    </Grid>

                    <!-- Right column: Description -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="2.5*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabelMedium}"/>
                        <TextBox x:Name="MDTDDescription" Grid.Row="1" Margin="5" Style="{StaticResource InputFieldMultiline}" Height="90"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- COMPLETE BUTTON -->
            <Grid Grid.Row="1">
                <Button x:Name="MDTDComplete"
                    Style="{StaticResource ManagerCompleteButton}"
                    Click="CompleteTask">
                    Compléter La Tâche
                </Button>
            </Grid>

            <!-- MODIFY + DELETE -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MDTDModify"
                    Grid.Column="0"
                    Style="{StaticResource ModifyButton}"
                      
                    Click="ModifyTask">
                    Modifier
                </Button>

                <Button x:Name="MDTDDelete"
                    Grid.Column="1"
                    Style="{StaticResource DeleteButton}"
                    Click="DeleteTask">
                    Supprimer
                </Button>
            </Grid>
        </Grid>
    </Grid>

</Page>
