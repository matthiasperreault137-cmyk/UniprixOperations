<Page x:Class="UniprixOperations.ManagerPages.ManagerAllExpiredProducts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerAllExpiredProducts">
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTasks">Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource ManagerSelectedTab}" Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTaskHistory">Historique</Button>
                </Grid>
                <Grid Grid.Row="4">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenUserMenu">Utilisateurs</Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SSectionDisplay"
                        Grid.Column="2"
                        Style="{StaticResource PageTitle}">Tous les produits</TextBlock>

                <Button Grid.Column="3"
                        
                        Style="{StaticResource PrintButton}"
                        Click="PrintProducts">Imprimer la liste</Button>
                <Button Grid.Column="4"
                        
                        Style="{StaticResource ClearAll}"
                        Click="DeleteProducts">Supprimer tout</Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="MAPSearchBox" Grid.Column="0" Style="{StaticResource InputField}" TextChanged="SearchTextChanged"/>
                    <Grid x:Name="MAPDatePickerPanel" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" x:Name="MAPStartDate" SelectedDateChanged="DateChange"
                                    Style="{StaticResource ManagerDatePicker}" Margin="0,0,10,0"/>
                        <DatePicker Grid.Column="1" x:Name="MAPEndDate" SelectedDateChanged="DateChange"
                                    Style="{StaticResource ManagerDatePicker}" Margin="0,0,10,0"/>
                    </Grid>
                </Grid>
                <ComboBox x:Name="MAPFilters"  Grid.Column="1" Style="{StaticResource ManagerComboBox}" Margin="10" SelectedIndex="0" SelectionChanged="SearchFilterChanged">
                    <ComboBoxItem>Nom</ComboBoxItem>
                    <ComboBoxItem>Date D'expiration(plus lointaine)</ComboBoxItem>
                    <ComboBoxItem>Quantité</ComboBoxItem>
                    <ComboBoxItem>Code Upc</ComboBoxItem>
                    <ComboBoxItem>Date</ComboBoxItem>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="2" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" Style="{StaticResource ManagerScrollViewer}">
                    <StackPanel x:Name="MAPExpiredProductList">
                    </StackPanel>
                </ScrollViewer>
                <Frame Grid.Column="2" x:Name="MAPProductDetailsFrame">

                </Frame>
            </Grid>
        </Grid>

    </Grid>
</Page>
