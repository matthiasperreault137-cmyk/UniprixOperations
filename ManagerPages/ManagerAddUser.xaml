<Page x:Class="UniprixOperations.ManagerPages.ManagerAddUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerAddUser">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTasks">Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTaskHistory">Historique</Button>
                </Grid>
                <Grid Grid.Row="4">
                    <Button Style="{StaticResource ManagerSelectedTab}" Click="OpenUserMenu">Utilisateurs</Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Style="{StaticResource PageTitle}"> Ajouter Un Utilisateur</TextBlock>
            </Grid>
            <Border Grid.Row="1" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8*"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.7*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>

                                <!-- Nom de la tache -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelLarge}" >Nom de l'employé</TextBlock>
                                <TextBox x:Name="MAUName" Grid.Row="1" Style="{StaticResource InputField}"/>
                                </Grid>
                                <!-- Niveau d'assignation -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelLarge}">Rôle</TextBlock>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="MAUEmployeeCheck" Grid.Column="0" Content="Employé" Checked="MAUEmployeeCheck_Checked" Style="{StaticResource ManagerCheckBox}"/>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="MAUSupervisorCheck" Grid.Row="0" Content="Responsable" Checked="MAUSupervisorCheck_Checked" Style="{StaticResource ManagerCheckBox}"/>
                                            <CheckBox x:Name="MAUManagerCheck" Grid.Row="1" Content="Gérant" Checked="MAUManagerCheck_Checked" Style="{StaticResource ManagerCheckBox}"/>


                                        </Grid>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Mot de Passe" Style="{StaticResource FieldLabelMedium}"/>
                                            <TextBox Grid.Row="1" x:Name="MAUPassword" IsReadOnly="True" Style="{StaticResource InputField}"></TextBox>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Button Style="{StaticResource ManagerAddButton}"  Click="AddUser">Ajouter</Button>
                        </Grid>

                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
