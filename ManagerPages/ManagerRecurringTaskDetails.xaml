<Page x:Class="UniprixOperations.ManagerPages.ManagerRecurringTaskDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerRecurringTaskDetails">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="0.7*"/>
            <RowDefinition Height="0.7*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelMedium}" >Nom de la tache</TextBlock>
            <TextBox x:Name="MRTDName" IsReadOnly="True" Grid.Row="1" Style="{StaticResource InputField}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Date d'effectuation et heure -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelSmall}">Effectuer ceci à tous les  .... (jours)</TextBlock>
                <TextBox x:Name="MRTDRecurrence" IsReadOnly="True" Grid.Row="1" Style="{StaticResource InputField}"/>
            </Grid>

            <!-- Description -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelSmall}">Description</TextBlock>
                <TextBox x:Name="MRTDDescription" IsReadOnly="True" Grid.Row="1" Style="{StaticResource InputFieldMultiline}" Height="40"/>
            </Grid>

        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelLarge}">Sous Sections</TextBlock>
            <ScrollViewer Grid.Row="1" Margin="0,10,0,10">
                <StackPanel x:Name="MRTDSubtasks">

                </StackPanel>
            </ScrollViewer >
        </Grid>
        <Grid Grid.Row="3">
            <Button x:Name="MRTDComplete" Content="Compléter" Style="{StaticResource ManagerCompleteButton}" Height="60" Click="CompleteTask"></Button>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="MRTDModify" Grid.Column="0" Style="{StaticResource ModifyButton}" Height="60" Click="ModifyTask">Modifier</Button>
            <Button x:Name="MRTDDelete" Grid.Column="1" Style="{StaticResource DeleteButton}" Height="60" Click="DeleteTask">Supprimer</Button>
        </Grid>
    </Grid>
</Page>
