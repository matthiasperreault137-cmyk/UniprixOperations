<Page x:Class="UniprixOperations.ManagerPages.ManagerMainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerMainMenu">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource ManagerSelectedTab}" Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTasks">Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTaskHistory">Historique</Button>
                </Grid>
                <Grid Grid.Row="4">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenUserMenu">Utilisateurs</Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Style="{StaticResource PageTitle}" > Que Souhaitez-Vous Faire</TextBlock>
            </Grid>
            <Border Grid.Row="1" Padding="50,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="pack://application:,,,/Images/ManagerTasks.png" Stretch="Uniform"/>
                            <TextBlock Grid.Row="1" Text="Tâches" Style="{StaticResource Subtitle2}" FontSize="20" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Style="{StaticResource ManagerContinueButton}" Height="60" FontSize="15" Click="OpenTasks">Continuer →</Button>
                        </Grid>

                        <Grid Grid.Column="1" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="pack://application:,,,/Images/TaskHistory.png" Stretch="Uniform"/>
                            <TextBlock Grid.Row="1" Text="Historique Des Tâches" Style="{StaticResource Subtitle2}" FontSize="14" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Style="{StaticResource ManagerContinueButton}" Height="60" FontSize="15" Click="OpenTaskHistory">Continuer →</Button>
                        </Grid>

                        <Grid Grid.Column="2" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="pack://application:,,,/Images/Messages.png" Stretch="Uniform"/>
                            <TextBlock Grid.Row="1" Text="Messages" Style="{StaticResource Subtitle2}" FontSize="20" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Style="{StaticResource ManagerContinueButton}" Height="60" FontSize="15" Click="OpenMessages">Continuer →</Button>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="pack://application:,,,/Images/ManagerExpireMenu.png" Stretch="Uniform"/>
                            <TextBlock Grid.Row="1" Text="Produits Expirés" Style="{StaticResource Subtitle2}" FontSize="20" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Style="{StaticResource ManagerContinueButton}" Height="60" FontSize="15" Click="OpenExpiredProducts">Continuer →</Button>
                        </Grid>

                        <Grid Grid.Column="1" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="pack://application:,,,/Images/Users.png" Stretch="Uniform"/>
                            <TextBlock Grid.Row="1" Text="Utilisateur" Style="{StaticResource Subtitle2}" FontSize="20" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Style="{StaticResource ManagerContinueButton}" Height="60" FontSize="15" Click="OpenUserMenu">Continuer →</Button>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
