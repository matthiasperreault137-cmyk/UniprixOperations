<Page x:Class="UniprixOperations.ManagerPages.UserMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserMenu">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTasks">Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Style="{StaticResource ManagerUnselectedTab}" Click="OpenTaskHistory">Historique</Button>
                </Grid>
                <Grid Grid.Row="4">
                    <Button Style="{StaticResource ManagerSelectedTab}" Click="OpenUserMenu">Utilisateurs</Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Style="{StaticResource PageTitle}"> Que Souhaitez-Vous Faire</TextBlock>
            </Grid>
            <Border Grid.Row="1" Padding="50,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="0.7*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Image Source="pack://application:,,,/Images/UserList.png" ></Image>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock Style="{StaticResource Subtitle1}">Utilisateurs</TextBlock>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Button Style="{StaticResource ManagerContinueButton}" Click="OpenUsers">Continuer →</Button>
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="0.7*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Image Source="pack://application:,,,/Images/AddUser.png" ></Image>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock Style="{StaticResource Subtitle1}"> Ajouter un Utilisateur</TextBlock>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Button Style="{StaticResource ManagerContinueButton}" Click="OpenAddUser">Continuer →</Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
