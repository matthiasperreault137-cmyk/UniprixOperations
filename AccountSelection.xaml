<Page x:Class="UniprixOperations.AccountSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountSelection">
    <Border Grid.Row="2" Padding="30,30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Employee Column -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="0.5*"/>
                        <RowDefinition Height="0.7*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Image Source="pack://application:,,,/Images/EmployeeIcon.png"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock TextAlignment="Center" Foreground="#FF0C4DA2" FontSize="15" VerticalAlignment="Center">Personnel en Magasin</TextBlock>
                    </Grid>
                    <Grid Grid.Row="2">
                        <TextBlock Style="{StaticResource Subtitle1}">Compte Employé</TextBlock>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Button Style="{StaticResource EmployeeContinueButton}" Click="OpenEmployeeLogin">Continuer →</Button>
                    </Grid>
                </Grid>

                <!-- Manager Column -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="0.5*"/>
                        <RowDefinition Height="0.7*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Image Source="pack://application:,,,/Images/ManagerIcon.png"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock TextAlignment="Center" Foreground="#FFF4793E" FontSize="15" VerticalAlignment="Center">Administration Et Support</TextBlock>
                    </Grid>
                    <Grid Grid.Row="2">
                        <TextBlock Style="{StaticResource Subtitle1}">Compte Responsable</TextBlock>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Button Style="{StaticResource ManagerContinueButton}" Click="OpenManagerLogin">Continuer →</Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Importer / Exporter Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Style="{StaticResource ImportButton}" Height="50" Width="100" Margin="0,0,12,0" Click="ImportData"/>
                <Button Style="{StaticResource ExportButton}" Height="50" Width="100" Click="ExportData"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
