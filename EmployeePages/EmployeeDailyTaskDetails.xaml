<Page x:Class="UniprixOperations.EmployeePages.EmployeeDailyTaskDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.EmployeePages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeeDailyTaskDetails">

    <Grid>
        <!-- Single column, full width -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP SECTION -->
        <Grid Grid.Row="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Task Name -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Nom de la tâche"
                           Style="{StaticResource FieldLabelLarge}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="30"
                       Margin="5"/>
                <TextBox x:Name="EDTDName"
                         Style="{StaticResource InputField}"
                     Width="400"
                     Margin="5"
                         IsReadOnly="True"/>
            </StackPanel>

            <!-- Divider spacing -->
            <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                Margin="10,8"/>

            <!-- Date, Heure, Description -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: Date + Heure -->
                <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        >
                    <StackPanel>
                        <TextBlock Text="Date"
                                   Style="{StaticResource FieldLabelMedium}"
                               HorizontalAlignment="Center"
                               FontSize="25"
                               Margin="5,5,5,3"/>
                        <TextBox x:Name="EDTDDate" Style="{StaticResource InputField}" Margin="5,0" IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Heure"
                                   Style="{StaticResource FieldLabelMedium}"
                               HorizontalAlignment="Center"
                               FontSize="25"
                               Margin="5,5,5,3"/>
                        <TextBox x:Name="EDTDHour" Style="{StaticResource InputField}" Margin="5,0" IsReadOnly="True"/>
                    </StackPanel>
                </StackPanel>

                <!-- Vertical Divider -->
                <Border Grid.Column="1"
                        Style="{StaticResource DividerVertical}"
                    BorderThickness="1,0,0,0"
                    Margin="0,10"/>

                <!-- Right column: Description -->
                <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">
                    <TextBlock Text="Description"
                               Style="{StaticResource FieldLabelLarge}"
                           HorizontalAlignment="Center"
                           FontSize="30"
                           Margin="5,5,5,3"/>
                    <TextBox x:Name="EDTDDescription"
                             Style="{StaticResource InputFieldMultiline}"
                         Height="120"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="5,0"
                             IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- COMPLETE BUTTON -->
        <Button Grid.Row="2" Style="{StaticResource EmployeeCompleteButton}" Click="CompleteTask">
        </Button>
    </Grid>
</Page>
