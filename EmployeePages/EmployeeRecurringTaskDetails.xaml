<Page x:Class="UniprixOperations.EmployeePages.EmployeeRecurringTaskDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.EmployeePages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeeRecurringTaskDetails">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.2*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelLarge}" TextAlignment="Center" VerticalAlignment="Center" FontSize="25">Nom de la tache</TextBlock>
            <TextBox x:Name="ERTDName" Style="{StaticResource InputField}" IsReadOnly="True" Grid.Row="1" TextAlignment="Center" FontSize="20" Width="400" Height="30"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Date d'effectuation et heure -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.4*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelMedium}" TextAlignment="Center" VerticalAlignment="Center" FontSize="20">Effectuer ceci à tous les  .... (jours)</TextBlock>
                <TextBox x:Name="ERTDRecurrence" Style="{StaticResource InputField}" IsReadOnly="True" Grid.Row="1" TextAlignment="Center" FontSize="20" Margin="5,5,5,5" Height="30"/>
            </Grid>

            <!-- Description -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.4*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelMedium}" TextAlignment="Center" VerticalAlignment="Center" FontSize="20">Description</TextBlock>
                <TextBox x:Name="ERTDDescription" Style="{StaticResource InputField}" IsReadOnly="True" Grid.Row="1" TextAlignment="Center" FontSize="20" Margin="5" Height="30"/>
            </Grid>

        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="30" TextAlignment="Center">Sous Sections</TextBlock>
            <ScrollViewer Grid.Row="1" Margin="0,10,0,10">
                <StackPanel x:Name="ERTDSubtasks">

                </StackPanel>
            </ScrollViewer >
        </Grid>
        <Grid Grid.Row="3">
            <Button x:Name="ERTDComplete" Style="{StaticResource EmployeeCompleteButton}" Height="60" Click="CompleteTask"></Button>
        </Grid>
    </Grid>
</Page>
