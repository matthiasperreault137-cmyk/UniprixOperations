<Page x:Class="UniprixOperations.EmployeeLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeeLogin">

    <Border Grid.Row="1" Padding="100,30">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.7*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Image Source="pack://application:,,,/Images/EmployeeIcon.png" ></Image>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBlock TextAlignment="Center" Foreground="#FF0C4DA2" FontSize="15" VerticalAlignment="Center"> Personnel en Magasin</TextBlock>
                </Grid>
                <Grid Grid.Row="2">
                    <ComboBox x:Name="EmployeeComboBox" Style="{StaticResource EmployeeComboBox}" Width="230">
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Style="{StaticResource EmployeeContinueButton}" Width="400" Height="100" Click="ConnectUser">Se Connecter</Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
