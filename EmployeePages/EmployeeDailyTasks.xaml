<Page x:Class="UniprixOperations.EmployeeDailyTasks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeeDailyTasks">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource EmployeeUnselectedTab}"  Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource EmployeeSelectedTab}" Click="OpenTasks" >Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource EmployeeUnselectedTab}" Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Style="{StaticResource PageTitle}" > Tâches Quotidiennes</TextBlock>
            </Grid>
            <Border Grid.Row="1" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition Height="6*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Description1}" Text="Sélectionner une date pour voir les tâches correspondantes"/>
                        <DatePicker x:Name="EDTDatePicker" Grid.Row="1" Style="{StaticResource EmployeeDatePicker}" SelectedDateChanged="DateChange"/>
                        <ScrollViewer Grid.Row="2">
                            <StackPanel x:Name="EDTTaskList">

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Frame x:Name="EDTTaskFrame" Grid.Column="1">

                    </Frame>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
