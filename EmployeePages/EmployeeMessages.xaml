<Page x:Class="UniprixOperations.EmployeePages.EmployeeMessages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UniprixOperations.EmployeePages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeeMessages">

<Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100"/>
        <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- Left nav -->
        <Grid Grid.Column="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource EmployeeUnselectedTab}" Click="OpenMainMenu">Accueil</Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Button Style="{StaticResource EmployeeUnselectedTab}" Click="OpenTasks">Tâches</Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource EmployeeUnselectedTab}" Click="OpenExpiredProducts">Expirations</Button>
                </Grid>
            </Grid>
        </Grid>

    <!-- Message board -->
    <Grid Grid.Column="1" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Clear button -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Tableau de messages"
                       Style="{StaticResource Subtitle1}"
                       HorizontalAlignment="Left"/>
            <Button Grid.Column="1"
                    Style="{StaticResource ClearAll}"
                    Click="DeleteMessages">
                Effacer tout
            </Button>
        </Grid>

        <!-- Message list -->
        <Border Grid.Row="1"
                Style="{StaticResource MessageBoard}">
                <ScrollViewer Style="{StaticResource ManagerScrollViewer}">
                    <StackPanel x:Name="EMMessages">

                    </StackPanel>
                </ScrollViewer>
        </Border>

        <!-- New message input -->
        <TextBox Grid.Row="2"
                 x:Name="EMMessageInput"
                 FontSize="13"
                 Padding="6"
                 Margin="0,6,0,4"
                 Height="60"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" 
                 KeyDown="EnterKeyDown"/>

        <!-- Send button -->
        <Grid Grid.Row="3" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                       Text="Écrire un message"
                       Style="{StaticResource Subtitle1}"
                        HorizontalAlignment="Left"/>
                <Button Grid.Column="1"
                    Style="{StaticResource PostButton}"
                    Click="SendMessageClick">
                    Publier
                </Button>
            </Grid>
        </Grid>

</Grid>

</Page>
